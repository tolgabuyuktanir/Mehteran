{
  "name": "mehteran",
  "version": "0.2.0",
  "description": "Local AI workflows on the AI tools you already use (Claude Code, Codex, Antigravity CLI, local models). This package installs and starts Mehteran.",
  "bin": {
    "mehteran": "bin/mehteran.js"
  },
  "files": [
    "bin",
    "mehteran.tar.gz"
  ],
  "scripts": {
    "prepack": "git -C .. archive --format=tar.gz --output=npm/mehteran.tar.gz HEAD",
    "postpack": "node -e \"require('fs').rmSync('mehteran.tar.gz', {force: true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolgabuyuktanir/Mehteran.git"
  },
  "homepage": "https://tolgabuyuktanir.github.io/Mehteran/",
  "keywords": ["ai", "workflow", "claude", "codex", "ollama"],
  "license": "MIT"
}
