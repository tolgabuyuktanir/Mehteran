# Installed on each computer by "Install missing tools" (portable Node.js, Codex, Gemini)
.runtime/

# Logs and state of this computer
.jobs/

# Packages built on this computer
dist/

# The book translation's books (see below): each user's own data
books/

# Secrets never belong in the repository (the application keeps none in this folder)
.env
.env.*
*.pem
*.key

# Assistant session notes
.remember/
.claude/
graphify-out/

# Python and operating system files
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db

# The book translation app, no longer part of Mehteran: on a computer that used it, Mehteran keeps it from the git
# history (mehteran/update.py), and these paths stay out of git. Its user files (settings, instructions) too.
/pipeline/
/translate
/translate.cmd
/scripts/start.sh
/scripts/start.cmd
/Open Interface.command
/Open Interface.bat
/config.default.toml
/docs/guide.md
/docs/guide.tr.md
/config.toml
/prompts/

# The publisher's Word template (uploaded in the interface)
/export/
/npm/mehteran.tar.gz
# Personal glossaries (names of real people): kept on this computer only
/glossary/
