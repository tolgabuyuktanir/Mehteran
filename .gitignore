# Installed on each computer by "Install missing tools" (portable Node.js, Codex, Gemini)
.runtime/

# Logs and state of this computer
.jobs/

# Written by './translate package'
dist/

# Books, their intermediate work and the translations: each user's own data
books/

# Secrets never belong in the repository (the application keeps none in this folder)
.env
.env.*
*.pem
*.key

# Assistant session notes
.remember/
.claude/
graphify-out/

# Python and operating system files
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db

# The user's own settings and instructions: made from config.default.toml and prompts/defaults/ at the first start,
# never changed by an update ("git pull"). See pipeline/userfiles.py.
/config.toml
/prompts/*.md
/prompts/custom/
/prompts/.defaults.json
# The publisher's Word template (uploaded in the interface)
/export/
